# Frontend dev overrides — copied to ../.env.development.local by `make dev-setup`.
# Next.js loads .env.development.local (highest precedence) ONLY for `next dev`,
# so your prod-pointing .env.local stays intact for builds.

NEXT_PUBLIC_API_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8080
COOKIE_SECURE=false
COOKIE_DOMAIN=
